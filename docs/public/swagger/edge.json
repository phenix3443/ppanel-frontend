    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "NodeSecret": {
            "type": "apiKey",
            "name": "secret_key",
            "in": "query"
        },
        "TelegramSecret": {
            "type": "apiKey",
            "name": "X-Telegram-Bot-Api-Secret-Token",
            "in": "header"
        }
    }
}