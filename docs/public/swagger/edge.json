{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "HTTP API for PPanel's Hertz server. Application errors are returned in the response code and message fields.",
        "title": "PPanel API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/edge/v1/manifest": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "edge"
                ],
                "summary": "Get Edge subscription manifest",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Subscription token",
                        "name": "token",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "PPanel Edge HMAC credential",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "One-time UUID bound into the HMAC",
                        "name": "X-Request-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.EdgeManifestResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.EdgeManifestProxy": {
            "type": "object",
            "properties": {
                "cipher": {
                    "type": "string"
                },
                "flow": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "protocol": {
                    "type": "string"
                },
                "server": {
                    "type": "string"
                },
                "sort": {
                    "type": "integer"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tls": {
                    "$ref": "#/definitions/dto.EdgeManifestTLS"
                },
                "transport": {
                    "$ref": "#/definitions/dto.EdgeManifestTransport"
                },
                "udp": {
                    "type": "boolean"
                },
                "uuid": {
                    "type": "string"
                }
            }
        },
        "dto.EdgeManifestResponse": {
            "type": "object",
            "properties": {
                "generated_at": {
                    "type": "string"
                },
                "notices": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "proxies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.EdgeManifestProxy"
                    }
                },
                "revision": {
                    "type": "string"
                },
                "schema_version": {
