                    "type": "integer"
                },
                "expires_at": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "traffic_limit": {
                    "type": "integer"
                },
                "update_interval_hours": {
                    "type": "integer"
                },
                "upload": {
                    "type": "integer"
                },
                "web_page_url": {
                    "type": "string"
                }
            }
        },
        "dto.EdgeManifestTLS": {
            "type": "object",
            "properties": {
                "alpn": {
                    "type": "array",
